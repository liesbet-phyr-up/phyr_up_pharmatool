# Names only. No values. Do not commit real secrets.
# Copy names into Railway Variables. VITE_* are inlined at `pnpm run build`.

# --- Runtime (server) ---
NODE_ENV=
PORT=
DATABASE_URL=
JWT_SECRET=

# --- First-party auth (OTP login + invite mail) ---
# BOOTSTRAP_ADMIN_EMAIL: one-shot bootstrap admin (see server/db.ts bootstrapAdmin).
BOOTSTRAP_ADMIN_EMAIL=
MAIL_FROM=
RESEND_API_KEY=

# --- Manus OAuth (legacy; does not work off the Manus platform) ---
# Decision: replaced by first-party auth; kept for reference only.
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# --- Manus Forge leftovers (storage / notify / heartbeat). Do not expect these to work on Railway. ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Optional; baked into client/index.html at Vite build time ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Naledi POC (MAXIMED-NALEDI-001). Server-only. Never VITE_ prefix the API key. ---
# NALEDI_ENABLED: "true" or "1" to show Talk to Naledi. Anything else hides her.
# ANAM_API_KEY: server mint of session tokens. Leave empty to use widget + domain allowlist.
# ANAM_PERSONA_ID: published Naledi persona id from Anam Lab (placeholder until Henry supplies it).
NALEDI_ENABLED=
ANAM_API_KEY=
ANAM_PERSONA_ID=
