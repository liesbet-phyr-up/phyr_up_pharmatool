# Names only. No values. Do not commit real secrets.
# Copy names into Railway Variables. VITE_* are inlined at `pnpm run build`.

# --- Runtime (server) ---
NODE_ENV=
PORT=
DATABASE_URL=
JWT_SECRET=
OWNER_OPEN_ID=

# --- Manus OAuth (legacy; does not work off the Manus platform) ---
# Decision: replace before staff can sign in on Railway. See NOTES.md.
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# --- Manus Forge leftovers (storage / notify / heartbeat). Do not expect these to work on Railway. ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Optional; baked into client/index.html at Vite build time ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
